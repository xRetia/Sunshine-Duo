# ============================================================
# Sunshine-Duo .gitignore
# 原则：只提交源码(src\)、运行时载荷与模板；本机生成的文件一律忽略。
# ============================================================

# ---- 运行时载荷（不入库，随发布 ZIP 分发；2026-11-27 从仓库历史出库）----
assets/
bin/
drivers/
Links/
tools/
setup.exe
sunshine.exe
zlib1.dll

# ---- 日志（含轮转备份）----
*.log
*.log.backup
tools/install-log.txt

# ---- Sunshine 运行配置（仅允许 config/apps.json 入库，其余全部本机生成）----
config/*
!config/apps.json

# ---- 密钥与凭据（本机生成，严禁入库）----
config/credentials/
bin/SunshineDuoCore/rdp.cred

# ---- SunshineDuoCore 本机运行状态（服务/显示工作进程自写）----
bin/SunshineDuoCore/config.json
bin/SunshineDuoCore/display-worker.json
bin/SunshineDuoCore/display-disabled.json
bin/SunshineDuoCore/display-mode-request.json
bin/SunshineDuoCore/display-mode-result.json
bin/SunshineDuoCore/display-worker.stop
bin/SunshineDuoCore/cursor-hidden.marker
bin/SunshineDuoCore/easytier.out

# ---- 本机生成的工具配置（安装时按本机路径重写）----
tools/GameManager.json

# ---- 构建现场与临时缓存 ----
src/SunshineDuoCore/.duocore-build/
.temp/
__pycache__/
*.pyc

# ---- SunshineDuoTray 托盘：源码在 src\trayapp，部署产物（exe）入 bin\SunshineDuoTray；本机生成物忽略 ----
src/trayapp/bin/
src/trayapp/obj/
src/trayapp/publish/
src/trayapp/trayapp.json
bin/SunshineDuoTray/trayapp.json
bin/SunshineDuoTray/SunshineDuoTray.exe.WebView2/
bin/SunshineDuoTray/SunshineDuoTray.pdb
bin/SunshineDuoTray/SunshineDuoTray.exe.bak

# ---- 游戏快捷方式（指向本机游戏，别人机器无效；目录本身靠 README.md 占位入库）----
Links/*
!Links/README.md

# ---- 安装器（src\SetupWizard）：源码入库；构建现场与 pdb 忽略 ----
src/SetupWizard/bin/
src/SetupWizard/obj/

# ---- 本机崩溃转储 ----
.wsguard-build/
